{
  "expo": {
    "name": "ahaar-app",
    "slug": "ahaar-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/images/ahaar2-adaptive.png",
    "scheme": "ahaarapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/images/ahaar2-adaptive.png",
        "monochromeImage": "./assets/images/images/ahaar2-adaptive.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sohagexpo.ahaarapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/images/ahaar2.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "867c988f-3ef3-46b8-be64-f361cc7072d2"
      }
    }
  }
}
