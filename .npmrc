# React Native's Metro bundler and Gradle autolinking both resolve files by
# walking real paths, so pnpm's default symlinked node_modules breaks them:
# the app entry (`expo-router/entry`) fails to resolve during the release JS
# bundle, which is what fails the "Run gradlew" phase on EAS Build.
#
# A hoisted node_modules is what Expo documents for pnpm. Kept here as well as
# in pnpm-workspace.yaml because pnpm <11 reads this file, and the EAS builder
# image may not run pnpm 11.
node-linker=hoisted
