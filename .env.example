# Copy to `.env.local` (gitignored) and adjust for your machine.
#
# EXPO_PUBLIC_* is the only prefix Expo inlines into the client bundle, so
# nothing secret belongs in this file — it ships inside the app binary.

# ── API base URL ─────────────────────────────────────────────────────────────
# Base URL of the Laravel API, including the /api/v1 prefix.
#
# Defaults to the local Herd backend, matching the web app's .env.local so both
# clients read the same database and the same homepage CMS content.
EXPO_PUBLIC_API_URL=https://ahaar-backend.test/api/v1

# `ahaar-backend.test` resolves to 127.0.0.1 through this machine's hosts file
# and is served with Herd's self-signed certificate. It therefore works in the
# iOS simulator and on `expo start --web`, but NOT in Expo Go on a phone or in an
# Android emulator: neither resolves the hostname, and neither trusts the
# certificate. The symptom is empty lists and spinners with no visible error,
# because the request fails at the transport layer before the app sees it.
#
# For a device or Android emulator, use your machine's LAN IP with Herd exposed
# on that interface:
# EXPO_PUBLIC_API_URL=https://192.168.0.151/api/v1
#
# Hosted staging (different database):
EXPO_PUBLIC_API_URL=https://api.ahaar.store/api/v1
#
# Production subdomain — fill in at deploy time:
# EXPO_PUBLIC_API_URL=https://<subdomain>/api/v1


# Sentry DSN — leave blank to disable error reporting (step 7).
EXPO_PUBLIC_SENTRY_DSN=

# ── Google Maps (build-time, NOT EXPO_PUBLIC) ────────────────────────────────
# Read by app.config.ts into the native project, so changing them needs a new
# build — not just a Metro restart. There is deliberately no EXPO_PUBLIC_ maps
# key here: the map is drawn by the native SDK, which reads the key from
# AndroidManifest, so an EXPO_PUBLIC_ one would ship in the JS bundle and be
# read by nothing.
#
# Its own key, never the web one — an HTTP-referrer restriction rejects Android.
#   API:         Maps SDK for Android
#   Restriction: Android apps → com.sohagexpo.ahaarapp + the build's SHA-1
#                (`eas credentials`; add the debug SHA-1 too).
# Empty is supported: Android falls back to the OpenStreetMap picker.
# For EAS builds set it with `eas env:create` rather than committing it.
GOOGLE_MAPS_ANDROID_API_KEY=
# Optional: without it iOS draws Apple Maps (no key needed). Restrict by bundle
# identifier if you add one.
GOOGLE_MAPS_IOS_API_KEY=

# ── Google Sign-In (native, @react-native-google-signin) ─────────────────────
# Client ids are public identifiers, not secrets. All three come from the same
# Google Cloud project as the API's GOOGLE_CLIENT_ID. Needs a development build:
# Expo Go doesn't include the native module, so the Google buttons stay hidden.
#
# Web client: the audience of the ID token the API verifies. Must equal
# GOOGLE_CLIENT_ID in ahaar-backend/.env.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Android client: package com.sohagexpo.ahaarapp + SHA-1 of *each* signing key
# (debug keystore, EAS upload key, Play app signing key). A missing SHA-1 shows
# up as DEVELOPER_ERROR. The app doesn't read this id; it's kept for reference.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# iOS client: bundle id com.sohagexpo.ahaarapp. app.config.ts derives the URL
# scheme from it at build time, so changing it needs a new build.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
